Sub CalculateAllRoundsWithPenaltyAndHighlight()
    Dim ws As Worksheet
    Dim wsResult As Worksheet
    Dim wsPenalty As Worksheet
    Dim lastRow As Long, i As Long
    Dim dictMatch As Object, dictTotal As Object, dictKill As Object
    Dim dictPenalty As Object
    Dim key As String, team As String, gameId As String
    Dim tScore As Double, kScore As Double, pScore As Double
    Dim colTeam As Integer, colGame As Integer
    Dim colTotal As Integer, colKill As Integer
    Dim pColTeam As Integer, pColPenalty As Integer
    Dim dataFound As Boolean
    
    Set dictMatch = CreateObject("Scripting.Dictionary")
    Set dictTotal = CreateObject("Scripting.Dictionary")
    Set dictKill = CreateObject("Scripting.Dictionary")
    Set dictPenalty = CreateObject("Scripting.Dictionary")
    
    dataFound = False
    
    ' 1. 모든 시트에서 기본 점수 수집 (결과, 패널티 시트 제외)
    For Each ws In ActiveWorkbook.Worksheets
        If ws.Name <> "결과" And ws.Name <> "패널티" Then
            colTeam = 0: colGame = 0: colTotal = 0: colKill = 0
            
            On Error Resume Next
            colTeam = ws.Rows(1).Find("teamName", LookAt:=xlPart).Column
            colGame = ws.Rows(1).Find("gameId", LookAt:=xlPart).Column
            colTotal = ws.Rows(1).Find("tournament total score", LookAt:=xlPart).Column
            colKill = ws.Rows(1).Find("tournament kill score", LookAt:=xlPart).Column
            On Error GoTo 0
            
            If colTeam > 0 And colGame > 0 And colTotal > 0 And colKill > 0 Then
                dataFound = True
                lastRow = ws.Cells(ws.Rows.Count, colTeam).End(xlUp).Row
                
                For i = 2 To lastRow
                    team = Trim(CStr(ws.Cells(i, colTeam).Value))
                    gameId = Trim(CStr(ws.Cells(i, colGame).Value))
                    tScore = Val(ws.Cells(i, colTotal).Value)
                    kScore = Val(ws.Cells(i, colKill).Value)
                    
                    If team <> "" Then
                        key = gameId & "_" & team
                        
                        If Not dictMatch.Exists(key) Then
                            dictMatch.Add key, True
                            
                            If dictTotal.Exists(team) Then
                                dictTotal(team) = dictTotal(team) + tScore
                                dictKill(team) = dictKill(team) + kScore
                            Else
                                dictTotal.Add team, tScore
                                dictKill.Add team, kScore
                            End If
                        End If
                    End If
                Next i
            End If
        End If
    Next ws
    
    If Not dataFound Then
        MsgBox "점수를 계산할 데이터가 없습니다.", vbCritical
        Exit Sub
    End If
    
    ' 2. "패널티" 시트가 있으면 패널티 점수 수집
    On Error Resume Next
    Set wsPenalty = ActiveWorkbook.Sheets("패널티")
    On Error GoTo 0
    
    If Not wsPenalty Is Nothing Then
        pColTeam = 0: pColPenalty = 0
        On Error Resume Next
        pColTeam = wsPenalty.Rows(1).Find("teamName", LookAt:=xlPart).Column
        pColPenalty = wsPenalty.Rows(1).Find("penalty", LookAt:=xlPart).Column
        On Error GoTo 0
        
        If pColTeam > 0 And pColPenalty > 0 Then
            lastRow = wsPenalty.Cells(wsPenalty.Rows.Count, pColTeam).End(xlUp).Row
            For i = 2 To lastRow
                team = Trim(CStr(wsPenalty.Cells(i, pColTeam).Value))
                pScore = Val(wsPenalty.Cells(i, pColPenalty).Value) ' 양수로 적어도 됨
                
                If team <> "" And pScore > 0 Then
                    If dictPenalty.Exists(team) Then
                        dictPenalty(team) = dictPenalty(team) + pScore
                    Else
                        dictPenalty.Add team, pScore
                    End If
                End If
            Next i
        End If
    End If
    
    ' 3. 결과 시트 생성
    On Error Resume Next
    Application.DisplayAlerts = False
    Sheets("결과").Delete
    Application.DisplayAlerts = True
    On Error GoTo 0
    
    Set wsResult = Sheets.Add(Before:=ActiveWorkbook.Sheets(1))
    wsResult.Name = "결과"
    
    wsResult.Cells(1, 1).Value = "위"
    wsResult.Cells(1, 2).Value = "팀명"
    wsResult.Cells(1, 3).Value = "TS"
    wsResult.Cells(1, 4).Value = "KS"
    wsResult.Cells(1, 5).Value = "감점"
    wsResult.Range("A1:E1").Font.Bold = True
    wsResult.Range("A1:E1").Interior.Color = RGB(220, 230, 241)
    
    Dim outputRow As Long
    outputRow = 2
    Dim vKey As Variant
    Dim finalScore As Double
    Dim penaltyPoints As Double
    
    For Each vKey In dictTotal.Keys
        penaltyPoints = 0
        If dictPenalty.Exists(vKey) Then
            penaltyPoints = dictPenalty(vKey)
        End If
        
        ' 패널티 차감 (총점에서 뺌)
        finalScore = dictTotal(vKey) - penaltyPoints
        
        wsResult.Cells(outputRow, 2).Value = vKey
        wsResult.Cells(outputRow, 3).Value = finalScore
        wsResult.Cells(outputRow, 4).Value = dictKill(vKey)
        
        ' 패널티가 0보다 크면 빨간색으로 표시
        wsResult.Cells(outputRow, 5).Value = penaltyPoints
        If penaltyPoints > 0 Then
            wsResult.Cells(outputRow, 5).Font.Color = vbRed
            wsResult.Cells(outputRow, 5).Font.Bold = True
        End If
        
        outputRow = outputRow + 1
    Next vKey
    
    ' 4. 순위 정렬 (1순위: Final TS 내림차순, 2순위: Kill Score 내림차순)
    If outputRow > 2 Then
        wsResult.Sort.SortFields.Clear
        wsResult.Sort.SortFields.Add Key:=wsResult.Range("C2:C" & outputRow - 1), SortOn:=xlSortOnValues, Order:=xlDescending
        wsResult.Sort.SortFields.Add Key:=wsResult.Range("D2:D" & outputRow - 1), SortOn:=xlSortOnValues, Order:=xlDescending
        With wsResult.Sort
            .SetRange wsResult.Range("B1:E" & outputRow - 1)
            .Header = xlYes
            .Apply
        End With
        
        ' 순위 번호 매기기
        For i = 2 To outputRow - 1
            wsResult.Cells(i, 1).Value = i - 1
        Next i
    End If
    
    wsResult.Columns.AutoFit
    wsResult.Range("A1:E" & outputRow - 1).Borders.LineStyle = xlContinuous
    
    ' ----------------------------------------------------
    ' 5. [추가된 부분] 60점 이상인 팀 배경색 노란색으로 칠하기
    ' ----------------------------------------------------
    For i = 2 To outputRow - 1
        ' 3번째 열(Final TS)의 점수가 60 이상인지 확인
        If wsResult.Cells(i, 3).Value >= 60 Then
            ' A열(1)부터 E열(5)까지 파스텔 노란색으로 칠함
            wsResult.Range(wsResult.Cells(i, 1), wsResult.Cells(i, 5)).Interior.Color = RGB(255, 255, 153)
        End If
    Next i
    ' ----------------------------------------------------
    
    MsgBox "60점 이상 팀 하이라이트까지 완벽하게 적용되었습니다!", vbInformation
End Sub
